{
  "name": "openroll",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-models.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-models.mjs",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "licenses": "node scripts/licenses.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run licenses",
    "postinstall": "node scripts/copy-models.mjs",
    "tune:audio": "node scripts/tune-audio-postprocess.mjs",
    "real-check:sheet": "playwright test -c scripts/real-check/sheet.config.ts"
  },
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "@tonejs/midi": "^2.0.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tone": "^15.1.22",
    "verovio": "^6.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
